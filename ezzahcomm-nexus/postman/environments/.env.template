# NEXUS API — Environment Variable Template
# Copy to .env and fill in values. Never commit .env to Git.

# ── Server ──────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=                  # SECRET — used to sign/verify JWTs

# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # SECRET — never expose publicly
SUPABASE_ANON_KEY=

# ── Redis (optional — rate limiting shared across cluster) ─
REDIS_URL=                   # e.g. redis://localhost:6379 (leave blank to use in-memory store)

# ── M-Pesa / Daraja ──────────────────────────────────────
MPESA_ENV=production         # "production" or "sandbox"
MPESA_CONSUMER_KEY=          # SECRET
MPESA_CONSUMER_SECRET=       # SECRET
MPESA_SHORTCODE=
MPESA_PASSKEY=               # SECRET
MPESA_CALLBACK_URL=          # e.g. https://api.yourdomain.com/api/webhooks/daraja
MPESA_ALLOWED_IPS=           # comma-separated Safaricom IPs (optional override)
MPESA_B2C_SECURITY_CREDENTIAL=  # SECRET — required for B2C payouts

# ── Paystack ─────────────────────────────────────────────
PAYSTACK_SECRET_KEY=         # SECRET
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=     # SECRET — used to validate Paystack webhook signatures

# ── SMS / TextSMS ────────────────────────────────────────
TEXTSMS_API_KEY=             # SECRET
TEXTSMS_PARTNER_ID=          # SECRET — TextSMS partner ID
TEXTSMS_SENDER_ID=EZZAHCOMM
TEXTSMS_BASE_URL=            # optional override, default: https://sms.textsms.co.ke/api/services/sendsms/

# ── CORS ─────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
